<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ProFitness" parent="android:Theme.Material.Light.NoActionBar" />
    <!-- Base application theme. -->
    <style name="Base.Theme.ProFitness" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>
    <style name="RoundedImage12">
        <item name="cornerSize">12dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="AchievementCard">
        <item name="cardBackgroundColor">#121212</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">#1A3A3A</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="CategoryChipStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/bg_chip_unselected</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="TabTextStyle">
        <item name="android:textColor">@color/text_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>