<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1714"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_social_bg"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <View
                android:layout_width="120dp"
                android:layout_height="4dp"
                android:layout_centerInParent="true"
                android:background="#1AFFFFFF" />
            <View
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:layout_centerInParent="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="100dp"
                android:background="#00E5FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="STEP 3/5"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="What is your activity\nlevel?"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="This helps us calculate your daily caloric needs and plan intensity."
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/cardActivitySedentary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:background="@drawable/input_field_bg">
                <ImageView
                    android:id="@+id/iconSed"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_social_bg"
                    android:padding="10dp"
                    android:src="@drawable/ic_sit"
                    app:tint="#FFFFFF" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconSed"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sedentary" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Little to no exercise" android:textColor="#B3FFFFFF" android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/cardActivityLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:background="@drawable/input_field_bg"
                android:backgroundTint="#1A2421">
                <ImageView
                    android:id="@+id/iconLight"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_social_bg"
                    android:padding="10dp"
                    android:src="@drawable/ic_walk"
                    app:tint="#00E5FF" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconLight"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lightly Active" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exercise 1-3 days / week" android:textColor="#B3FFFFFF" android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/cardActivityModerate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:background="@drawable/input_field_bg">
                <ImageView
                    android:id="@+id/iconMod"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_social_bg"
                    android:padding="10dp"
                    android:src="@drawable/ic_weight"
                    app:tint="#FFFFFF" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconMod"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moderately Active" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exercise 3-5 days / week" android:textColor="#B3FFFFFF" android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/cardActivityAthlete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:background="@drawable/input_field_bg">
                <ImageView
                    android:id="@+id/iconAth"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_social_bg"
                    android:padding="10dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="#FFFFFF" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconAth"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Athlete" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily intense training" android:textColor="#B3FFFFFF" android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#00E5FF"
            android:text="CONTINUE →"
            android:textColor="#000000"
            android:textStyle="bold"
            app:cornerRadius="30dp" />

    </LinearLayout>
</ScrollView>