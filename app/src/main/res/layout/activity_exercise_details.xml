<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <RelativeLayout
        android:id="@+id/header_exercise"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Exercise Library"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header_exercise"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/exercise_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barbell Bench Press"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_add_to_workout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_add"
                    app:backgroundTint="@color/neon_cyan"
                    app:fabSize="mini" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/exercise_title"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tv_tag_muscle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/tag_bg" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="Chest" android:textColor="@color/text_gray" android:textSize="12sp" />
                    <TextView android:id="@+id/tv_tag_difficulty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/tag_bg" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="Beginner" android:textColor="@color/text_gray" android:textSize="12sp" />
                    <TextView android:id="@+id/tv_tag_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/tag_bg" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="15 min" android:textColor="@color/text_gray" android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/card_bg">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/bench_press_preview" />
                    <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/ic_play_circle" app:tint="@color/neon_cyan" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:drawablePadding="8dp"
                android:text="Instructions"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_" />

            <TextView
                android:id="@+id/tv_instructions_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="6dp"
                android:text="1. Lie flat on a bench and grip the barbell with hands slightly wider than shoulder-width.\n\n2. Plant your feet firmly on the floor and maintain a slight arch in your lower back.\n\n3. Lower the bar slowly to your mid-chest while keeping your elbows at a 45-degree angle.\n\n4. Push the bar back up forcefully to the starting position by extending your arms fully."
                android:textColor="@color/white"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="#1A1010"
                app:cardCornerRadius="16dp"
                app:strokeColor="#33FF4B4B"
                app:strokeWidth="1dp">
                <LinearLayout android:padding="16dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMMON MISTAKES" android:textColor="#FF4B4B" android:textStyle="bold" android:textSize="12sp" />
                    <TextView android:id="@+id/tv_common_mistakes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Flaring elbows out too wide, bouncing the bar off the chest, or lifting your glutes off the bench during the lift." android:textColor="@color/white" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:itemIconTint="@color/neon_cyan"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>