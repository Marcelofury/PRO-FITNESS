<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_bg_dark"
    app:cardCornerRadius="16dp">
    <RelativeLayout android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/ic_drop" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:background="@drawable/circle_bg_dark" android:src="@drawable/ic_water_drop" app:tint="@color/neon_cyan" />
        <TextView android:id="@+id/txt_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ic_drop" android:layout_marginStart="16dp" android:text="500 ml" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/txt_amount" android:layout_toEndOf="@id/ic_drop" android:layout_marginStart="16dp" android:text="10:45 AM" android:textColor="@color/text_gray" android:textSize="12sp" />
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_delete" app:tint="@color/text_gray" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>